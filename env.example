# Переменные окружения для Next.js приложения
# Скопируйте этот файл в .env.local и заполните реальными значениями

# Bot Webhook Configuration
# URL бота для отправки заявок (должен быть localhost/127.0.0.1 для безопасности)
BOT_WEBHOOK_URL=http://localhost:3001/api/application
# INTERNAL_SERVICE_HOSTS: дополнительный allowlist для внутренних сервисов (через запятую, без схемы)
# Например: bot,internal-bot
INTERNAL_SERVICE_HOSTS=

# Security Configuration
# Разрешенные источники для CORS/CSRF защиты (через запятую)
# Оставьте пустым для разрешения только same-origin запросов
ALLOWED_ORIGINS=https://nord-laundry.ru,http://localhost:3000

# Yandex SmartCaptcha
# Публичный ключ виджета; безопасно передаётся в HTML через серверный layout.
YANDEX_SMARTCAPTCHA_CLIENT_KEY=ВСТАВИТЬ_КЛИЕНТСКИЙ_КЛЮЧ
# Секретный ключ проверки; никогда не передавать на клиент и не коммитить реальное значение.
YANDEX_SMARTCAPTCHA_SERVER_KEY=ВСТАВИТЬ_КЛЮЧ_СЕРВЕРА

# Next.js Configuration
NEXT_PUBLIC_API_URL=https://your-domain.com

# Добавьте другие переменные по необходимости
